SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq API keys, comma-separated. The first is the main key; the others are
# only used when the one before fails (rate limit, revoked key, outage).
GROQ_API_KEYS=gsk_main_key,gsk_backup_key
# Optional: override the model.
# GROQ_MODEL=llama-3.1-8b-instant

# Main frontend URL: CORS + where Google login redirects back to.
FRONTEND_URL=http://localhost:5173
# Optional: extra allowed frontend origins, comma-separated (custom domain etc).
# FRONTEND_URLS=https://ascend-iota-one.vercel.app,https://yourdomain.com

# Optional: error reporting (sentry.io -> project -> Client Keys (DSN)).
# SENTRY_DSN=
# ENVIRONMENT=production

# Optional: per-user AI limits per day (defaults shown).
# AI_BRIEF_DAILY_LIMIT=1
# AI_COACH_DAILY_LIMIT=1
# AI_CIPHER_DAILY_LIMIT=20
# AI_CIPHER_COOLDOWN_SECONDS=10
